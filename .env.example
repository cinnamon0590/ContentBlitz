# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | production

# --- Required ---
OPENAI_API_KEY=sk-...

# --- Research providers (at least one recommended; chain = SerpAPI -> Tavily -> Perplexity) ---
SERPAPI_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- Optional alternate LLM providers (also uncomment packages in requirements.txt) ---
LLM_PROVIDER=openai            # openai | anthropic | gemini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Optional observability (LangSmith tracing) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contentblitz
